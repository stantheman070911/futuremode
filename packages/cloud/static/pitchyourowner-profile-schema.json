{
  "schema_version": "1.1.0-draft",
  "description": "PitchYourOwner owner-approved profile contract. animal_persona is public presentation data; owner-review metadata is controlled here rather than hard-coded in the prompt or UI. Confidence is enabled for owner review only and is never public or used in matching.",
  "field_order": [
    "history_scope",
    "animal_persona",
    "summary",
    "interests",
    "motivations",
    "active_problems",
    "recurring_topics",
    "friend_intent",
    "confidence"
  ],
  "core_fields": {
    "animal_persona": {
      "type": "string",
      "required": true,
      "max_length": 80
    },
    "summary": {
      "type": "string",
      "required": true,
      "max_length": 480
    },
    "interests": {
      "type": "string_array",
      "required": true,
      "max_items": 8,
      "item_max_length": 120
    },
    "motivations": {
      "type": "string_array",
      "required": true,
      "max_items": 8,
      "item_max_length": 160
    },
    "active_problems": {
      "type": "string_array",
      "required": true,
      "max_items": 8,
      "item_max_length": 180
    },
    "recurring_topics": {
      "type": "string_array",
      "required": true,
      "max_items": 8,
      "item_max_length": 140
    },
    "friend_intent": {
      "type": "string",
      "required": true,
      "max_length": 320
    },
    "history_scope": {
      "type": "string",
      "required": true,
      "max_length": 320
    }
  },
  "optional_fields": {
    "confidence": {
      "enabled": true,
      "type": "field_confidence_map",
      "targets": [
        "summary",
        "interests",
        "motivations",
        "active_problems",
        "recurring_topics",
        "friend_intent"
      ],
      "allowed_values": [
        "high",
        "medium",
        "low"
      ],
      "visibility": "owner_review_only",
      "matching_mode": "review_only",
      "required_when_enabled": true
    }
  },
  "excluded_fields": [
    "omitted_sensitive_data"
  ],
  "validation": {
    "reject_unknown_fields": true,
    "reject_empty_strings": true,
    "reject_duplicate_array_items": true
  }
}
