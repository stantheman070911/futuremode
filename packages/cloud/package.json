{
  "name": "@pitchyourowner/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:schema": "node scripts/sync-profile-schema.mjs",
    "sync:prompts": "node scripts/sync-owner-pitch-prompts.mjs",
    "sync:contracts": "npm run sync:schema && npm run sync:prompts",
    "prebuild": "npm run sync:contracts",
    "build": "tsc --noEmit",
    "pretest": "npm run sync:contracts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "synth": "cdk synth",
    "diff": "cdk diff --profile screenmark-root-bootstrap",
    "deploy:dev": "cdk deploy --profile screenmark-root-bootstrap --require-approval broadening",
    "demo:seed": "node scripts/demo/seed-profiles.mjs",
    "demo:match": "node scripts/demo/run-matching.mjs",
    "demo:api": "node scripts/demo/test-profile-api.mjs",
    "demo:clean": "node scripts/demo/clean-profiles.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1111.0",
    "@aws-sdk/client-dynamodb": "3.1111.0",
    "@aws-sdk/client-lambda": "^3.1111.0",
    "@aws-sdk/client-sesv2": "3.1111.0",
    "@aws-sdk/client-sns": "3.1111.0",
    "@aws-sdk/client-sqs": "3.1111.0",
    "@aws-sdk/lib-dynamodb": "3.1111.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.152",
    "@types/node": "24.3.0",
    "aws-cdk": "2.1136.0",
    "esbuild": "0.25.9",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
